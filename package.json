{
  "name": "birdflop",
  "version": "12.0.0",
  "homepage": "https://www.birdflop.com",
  "description": "The only 501(c)(3) nonprofit Minecraft server host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdflop/web.git"
  },
  "engines": {
    "node": ">=23.11.0"
  },
  "author": "birdflop",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "pnpm build.pkg && wrangler types && qwik build",
    "build.pkg": "cd packages/rgbirdflop && pnpm run build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "vite build -c adapters/cloudflare-pages/vite.config.mts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler types && pnpm run build && wrangler deploy",
    "dev": "wrangler dev",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "drizzle:check": "drizzle-kit check",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:up": "drizzle-kit up",
    "wrangler:migrate-local": "wrangler d1 migrations apply birdflop",
    "lint": "eslint \"src/**/*.ts*\"",
    "postinstall": "drizzle-kit generate && wrangler types",
    "preview": "qwik build preview && vite preview --open",
    "qwik-speak-extract": "qwik-speak-extract --supportedLangs=en-US,es-ES,ko-KR,de-DE,nl-NL,pl-PL,pt-PT,ru-RU,tr-TR,zh-CN --assetsPath=i18n",
    "serve": "wrangler pages dev ./dist --compatibility-flags=nodejs_als",
    "start": "vite --open --mode ssr --host",
    "qwik": "qwik"
  },
  "type": "module",
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@auth/drizzle-adapter": "^1.11.1",
    "@auth/qwik": "0.9.1",
    "@birdflop/rgbirdflop": "workspace:*",
    "@builder.io/qwik": "1.18.0",
    "@builder.io/qwik-city": "1.18.0",
    "@eslint/js": "^9.39.2",
    "@luminescent/ui": "^6.5.0-0",
    "@luminescent/ui-qwik": "^6.5.0-0",
    "@modular-forms/qwik": "^0.29.1",
    "@qwik.dev/partytown": "^0.11.2",
    "@shikijs/colorized-brackets": "^3.21.0",
    "@shikijs/engine-javascript": "^3.21.0",
    "@shikijs/rehype": "^3.21.0",
    "@shikijs/transformers": "^3.21.0",
    "@shikijs/types": "^3.21.0",
    "@tailwindcss/vite": "^4.1.18",
    "@types/eslint": "^9.6.1",
    "@types/node": "^25.0.5",
    "@types/three": "^0.182.0",
    "chart.js": "^4.5.1",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "eslint": "^9.39.2",
    "eslint-plugin-qwik": "1.18.0",
    "gifuct-js": "^2.1.2",
    "globals": "^17.0.0",
    "lucide-icons-qwik": "0.540.0",
    "qwik-speak": "^0.24.0",
    "shiki": "^3.21.0",
    "tailwindcss": "^4.1.18",
    "three": "^0.182.0",
    "threejs-toys": "^0.0.8",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.52.0",
    "vite": "7.3.1",
    "vite-tsconfig-paths": "6.0.4",
    "wrangler": "^4.58.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.5"
  },
  "packageManager": "pnpm@10.28.0"
}
