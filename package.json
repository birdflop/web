{
  "name": "birdflop",
  "author": {
    "name": "birdflop",
    "url": "https://birdflop.com"
  },
  "homepage": "https://birdflop.com",
  "bugs": {
    "url": "https://github.com/LuminescentDev/web/issues"
  },
  "version": "13.0.0",
  "license": "AGPL-3.0-or-later",
  "description": "The only 501(c)(3) nonprofit Minecraft server host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdflop/web.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.13.0"
    }
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build.pkg && wrangler types && qwik build",
    "build.pkg": "cd packages/rgbirdflop && pnpm run build && cd ../analyze && pnpm run build",
    "build.client": "vp build",
    "build.preview": "vp build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vp build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "vp dev --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "drizzle:check": "drizzle-kit check",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:up": "drizzle-kit up",
    "wrangler:migrate-local": "wrangler d1 migrations apply birdflop",
    "fmt": "vp fmt .",
    "fmt.check": "vp fmt --check .",
    "lint": "vp lint --quiet",
    "postinstall": "drizzle-kit generate && wrangler types",
    "preview": "qwik build && wrangler dev",
    "qwik-speak-extract": "qwik-speak-extract --supportedLangs=en-US,es-ES,ko-KR,de-DE,nl-NL,pl-PL,pt-PT,ru-RU,tr-TR,zh-CN --assetsPath=i18n",
    "serve": "wrangler dev",
    "start": "vp dev --open --mode ssr",
    "qwik": "qwik",
    "test": "vp test run",
    "test:watch": "vp test",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@auth/qwik": "0.9.3",
    "@birdflop/analyze": "workspace:*",
    "@birdflop/rgbirdflop": "workspace:*",
    "@builder.io/qwik-city": "^1.20.0",
    "@luminescent/icons-qwik": "^0.1.1",
    "@luminescent/ui": "^7.2.0-1",
    "@luminescent/ui-qwik": "7.0.0-25",
    "@qwik.dev/core": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/core@8785",
    "@qwik.dev/partytown": "^0.14.0",
    "@qwik.dev/router": "https://pkg.pr.new/QwikDev/qwik/@qwik.dev/router@8785",
    "@shikijs/colorized-brackets": "^4.3.1",
    "@shikijs/engine-javascript": "^4.3.1",
    "@shikijs/rehype": "^4.3.1",
    "@shikijs/transformers": "^4.3.1",
    "@shikijs/types": "^4.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.1.2",
    "@types/three": "^0.185.1",
    "better-sqlite3": "^13.0.2",
    "chart.js": "^4.5.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "gifuct-js": "^2.1.2",
    "globals": "17.8.0",
    "happy-dom": "^20.11.1",
    "jszip": "^3.10.1",
    "lucide-icons-qwik": "1.25.0-qwik-v2",
    "oxlint-plugin-qwik": "^0.0.9",
    "qwik-speak": "^0.24.0",
    "shiki": "^4.3.1",
    "simple-icons-qwik": "16.27.0-qwik-v2",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1",
    "ts-morph": "28",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "valibot": "^1.4.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.115.0",
    "yaml": "^2.9.0"
  }
}
