{
  "name": "birdflop",
  "author": "birdflop",
  "version": "12.0.0",
  "homepage": "https://www.birdflop.com",
  "license": "AGPL-3.0-or-later",
  "description": "The only 501(c)(3) nonprofit Minecraft server host.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/birdflop/web.git"
  },
  "engines": {
    "node": "^18.17.0 || ^20.3.0 || >=21.0.0"
  },
  "engines-annotation": "Mostly required by sharp which needs a Node-API v9 compatible runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build.pkg && wrangler types && qwik build",
    "build.pkg": "cd packages/rgbirdflop && pnpm run build",
    "build.client": "vite build",
    "build.preview": "vite build --ssr src/entry.preview.tsx",
    "build.server": "qwik check-client src dist && vite build -c adapters/cloudflare-workers/vite.config.ts",
    "build.types": "tsc --incremental --noEmit",
    "cf-typegen": "wrangler types",
    "deploy": "wrangler deploy",
    "dev": "vite --mode ssr",
    "dev.debug": "node --inspect-brk ./node_modules/vite/bin/vite.js --mode ssr --force",
    "drizzle:check": "drizzle-kit check",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:push": "drizzle-kit push",
    "drizzle:studio": "drizzle-kit studio",
    "drizzle:up": "drizzle-kit up",
    "wrangler:migrate-local": "wrangler d1 migrations apply birdflop",
    "fmt": "prettier --write .",
    "fmt.check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts*\"",
    "postinstall": "drizzle-kit generate && wrangler types",
    "preview": "qwik build preview && vite preview --open",
    "qwik-speak-extract": "qwik-speak-extract --supportedLangs=en-US,es-ES,ko-KR,de-DE,nl-NL,pl-PL,pt-PT,ru-RU,tr-TR,zh-CN --assetsPath=i18n",
    "serve": "wrangler dev",
    "start": "vite --open --mode ssr",
    "qwik": "qwik"
  },
  "devDependencies": {
    "@anuragroy/tailwindcss-animate": "^1.0.6",
    "@auth/drizzle-adapter": "^1.11.1",
    "@auth/qwik": "0.9.1",
    "@birdflop/rgbirdflop": "workspace:*",
    "@builder.io/qwik": "^1.19.2",
    "@builder.io/qwik-city": "^1.19.2",
    "@cloudflare/workers-types": "^4.20260316.1",
    "@eslint/js": "^10",
    "@luminescent/ui": "^6.8.2",
    "@luminescent/ui-qwik": "^6.8.2",
    "@modular-forms/qwik": "^0.29.1",
    "@qwik.dev/partytown": "^0.11.2",
    "@shikijs/colorized-brackets": "^4.0.1",
    "@shikijs/engine-javascript": "^4.0.1",
    "@shikijs/rehype": "^4.0.1",
    "@shikijs/transformers": "^4.0.1",
    "@shikijs/types": "^4.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "25.5.0",
    "@types/three": "^0.183.1",
    "better-sqlite3": "^12.8.0",
    "chart.js": "^4.5.1",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.45.1",
    "eslint": "10.0.3",
    "eslint-plugin-qwik": "^1.19.2",
    "gifuct-js": "^2.1.2",
    "globals": "17.4.0",
    "lucide-icons-qwik": "^0.577.2",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "qwik-speak": "^0.24.0",
    "shiki": "^4.0.1",
    "simple-icons-qwik": "^16.10.0",
    "tailwindcss": "^4.2.1",
    "three": "^0.183.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "typescript-plugin-css-modules": "latest",
    "undici": "*",
    "vite": "8.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.73.0",
    "yaml": "^2.8.2"
  }
}
