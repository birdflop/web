AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

ADMINS=

# Pterodactyl Application API key used to auto-tag Birdflop-hosted listings
# on the server list. Optional; detection is skipped when unset.
PANEL_API_KEY=
# Defaults to https://panel.birdflop.com when unset.
PANEL_URL=

# Cloudflare Turnstile (CAPTCHA) for server-list votes. The secret is required
# in production (votes are rejected without it); dev builds skip the check
# when it is unset.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
