{
  "name": "@birdflop/mc-status",
  "version": "1.1.0",
  "description": "Minecraft Server Status client for Java & Bedrock with full 1.16+ RGB hex color and MOTD component support.",
  "repository": {
    "type": "git",
    "url": "https://github.com/birdflop/web.git"
  },
  "main": "./lib/index.js",
  "types": "./lib-types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib-types/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.js"
    },
    "./motd": {
      "types": "./lib-types/motd/index.d.ts",
      "import": "./lib/motd/index.js",
      "require": "./lib/motd/index.js"
    }
  },
  "files": [
    "lib",
    "lib-types"
  ],
  "engines": {
    "node": ">=24.13.0"
  },
  "license": "AGPL-3.0-or-later",
  "private": false,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vp test run"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "typescript": "7.0.2"
  }
}
